+// Portable, dependency-free replacements for the four OpenSSL primitives that
+// Longfellow's util/crypto.h needs: SHA-256, AES-256-ECB (used as a PRF), and
+// RAND_bytes.
+//
+// Motivation: OpenSSL is the only thing standing between this library and a
+// WebAssembly build, and it is needed for very little. ECDSA and SHA-256
+// *verification* happen inside the ZK circuit, so the host side only needs a
+// hash, a block cipher, and an RNG. This header provides them with the same
+// names and signatures as the OpenSSL functions it replaces, so util/crypto.h
+// only has to switch which header it includes.
+//
+// Enable with -DLONGFELLOW_PORTABLE_CRYPTO=1. When it is not defined, nothing
+// here is compiled and the OpenSSL path is used unchanged.
+//
+// These implementations are correctness-oriented, not speed-oriented. They are
+// not constant-time and have no hardware acceleration. That is acceptable here:
+// the PRF and hash sit outside the proof's hot loop (measured: proving is
+// dominated by field arithmetic in the sumcheck, not by these), and the values
+// they process are not long-term secrets. Do not lift this header into a
+// context that needs side-channel resistance.
+
+#ifndef PRIVACY_PROOFS_ZK_LIB_UTIL_PORTABLE_CRYPTO_H_
+#define PRIVACY_PROOFS_ZK_LIB_UTIL_PORTABLE_CRYPTO_H_
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#include <sys/random.h>  // getentropy
+
+// ---------------------------------------------------------------------------
+// SHA-256, mirroring the OpenSSL SHA256_* API.
+//
+// SHA256_CTX must stay a plain assignable struct: Longfellow's SHA256::CopyState
+// snapshots a running hash with `sha_ = src.sha_`.
+// ---------------------------------------------------------------------------
+
+#define SHA256_DIGEST_LENGTH 32
+
+typedef struct {
+  uint32_t h[8];
+  uint64_t total_len;
+  uint8_t buf[64];
+  uint32_t buf_len;
+} SHA256_CTX;
+
+namespace portable_crypto_detail {
+
+static const uint32_t kSha256K[64] = {
+    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1,
+    0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
+    0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786,
+    0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
+    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147,
+    0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
+    0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b,
+    0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
+    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a,
+    0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
+    0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2};
+
+inline uint32_t Ror(uint32_t x, int n) { return (x >> n) | (x << (32 - n)); }
+
+inline void Sha256Block(uint32_t h[8], const uint8_t block[64]) {
+  uint32_t w[64];
+  for (int i = 0; i < 16; ++i) {
+    w[i] = (static_cast<uint32_t>(block[4 * i]) << 24) |
+           (static_cast<uint32_t>(block[4 * i + 1]) << 16) |
+           (static_cast<uint32_t>(block[4 * i + 2]) << 8) |
+           static_cast<uint32_t>(block[4 * i + 3]);
+  }
+  for (int i = 16; i < 64; ++i) {
+    uint32_t s0 = Ror(w[i - 15], 7) ^ Ror(w[i - 15], 18) ^ (w[i - 15] >> 3);
+    uint32_t s1 = Ror(w[i - 2], 17) ^ Ror(w[i - 2], 19) ^ (w[i - 2] >> 10);
+    w[i] = w[i - 16] + s0 + w[i - 7] + s1;
+  }
+
+  uint32_t a = h[0], b = h[1], c = h[2], d = h[3];
+  uint32_t e = h[4], f = h[5], g = h[6], hh = h[7];
+  for (int i = 0; i < 64; ++i) {
+    uint32_t S1 = Ror(e, 6) ^ Ror(e, 11) ^ Ror(e, 25);
+    uint32_t ch = (e & f) ^ (~e & g);
+    uint32_t t1 = hh + S1 + ch + kSha256K[i] + w[i];
+    uint32_t S0 = Ror(a, 2) ^ Ror(a, 13) ^ Ror(a, 22);
+    uint32_t mj = (a & b) ^ (a & c) ^ (b & c);
+    uint32_t t2 = S0 + mj;
+    hh = g;
+    g = f;
+    f = e;
+    e = d + t1;
+    d = c;
+    c = b;
+    b = a;
+    a = t1 + t2;
+  }
+  h[0] += a; h[1] += b; h[2] += c; h[3] += d;
+  h[4] += e; h[5] += f; h[6] += g; h[7] += hh;
+}
+
+}  // namespace portable_crypto_detail
+
+inline int SHA256_Init(SHA256_CTX* c) {
+  c->h[0] = 0x6a09e667; c->h[1] = 0xbb67ae85;
+  c->h[2] = 0x3c6ef372; c->h[3] = 0xa54ff53a;
+  c->h[4] = 0x510e527f; c->h[5] = 0x9b05688c;
+  c->h[6] = 0x1f83d9ab; c->h[7] = 0x5be0cd19;
+  c->total_len = 0;
+  c->buf_len = 0;
+  return 1;
+}
+
+inline int SHA256_Update(SHA256_CTX* c, const void* data, size_t len) {
+  const uint8_t* p = static_cast<const uint8_t*>(data);
+  c->total_len += len;
+  if (c->buf_len > 0) {
+    uint32_t need = 64 - c->buf_len;
+    uint32_t take = (len < need) ? static_cast<uint32_t>(len) : need;
+    memcpy(c->buf + c->buf_len, p, take);
+    c->buf_len += take;
+    p += take;
+    len -= take;
+    if (c->buf_len == 64) {
+      portable_crypto_detail::Sha256Block(c->h, c->buf);
+      c->buf_len = 0;
+    }
+  }
+  while (len >= 64) {
+    portable_crypto_detail::Sha256Block(c->h, p);
+    p += 64;
+    len -= 64;
+  }
+  if (len > 0) {
+    memcpy(c->buf, p, len);
+    c->buf_len = static_cast<uint32_t>(len);
+  }
+  return 1;
+}
+
+// Finalises on a copy, leaving *c usable. OpenSSL leaves the context spent, so
+// this is strictly more permissive: any usage valid against OpenSSL is valid
+// here.
+inline int SHA256_Final(uint8_t* md, SHA256_CTX* c) {
+  SHA256_CTX t = *c;
+  uint64_t bit_len = t.total_len * 8;
+  uint8_t pad = 0x80;
+  SHA256_Update(&t, &pad, 1);
+  uint8_t zero = 0x00;
+  while (t.buf_len != 56) SHA256_Update(&t, &zero, 1);
+  uint8_t lb[8];
+  for (int i = 0; i < 8; ++i) lb[i] = static_cast<uint8_t>(bit_len >> (56 - 8 * i));
+  SHA256_Update(&t, lb, 8);
+  for (int i = 0; i < 8; ++i) {
+    md[4 * i] = static_cast<uint8_t>(t.h[i] >> 24);
+    md[4 * i + 1] = static_cast<uint8_t>(t.h[i] >> 16);
+    md[4 * i + 2] = static_cast<uint8_t>(t.h[i] >> 8);
+    md[4 * i + 3] = static_cast<uint8_t>(t.h[i]);
+  }
+  return 1;
+}
+
+inline uint8_t* SHA256(const uint8_t* d, size_t n, uint8_t* md) {
+  SHA256_CTX c;
+  SHA256_Init(&c);
+  SHA256_Update(&c, d, n);
+  SHA256_Final(md, &c);
+  return md;
+}
+
+// ---------------------------------------------------------------------------
+// AES-256-ECB, mirroring the sliver of the EVP API that PRF uses.
+// ---------------------------------------------------------------------------
+
+namespace portable_crypto_detail {
+
+static const uint8_t kSbox[256] = {
+    0x63,0x7c,0x77,0x7b,0xf2,0x6b,0x6f,0xc5,0x30,0x01,0x67,0x2b,0xfe,0xd7,0xab,0x76,
+    0xca,0x82,0xc9,0x7d,0xfa,0x59,0x47,0xf0,0xad,0xd4,0xa2,0xaf,0x9c,0xa4,0x72,0xc0,
+    0xb7,0xfd,0x93,0x26,0x36,0x3f,0xf7,0xcc,0x34,0xa5,0xe5,0xf1,0x71,0xd8,0x31,0x15,
+    0x04,0xc7,0x23,0xc3,0x18,0x96,0x05,0x9a,0x07,0x12,0x80,0xe2,0xeb,0x27,0xb2,0x75,
+    0x09,0x83,0x2c,0x1a,0x1b,0x6e,0x5a,0xa0,0x52,0x3b,0xd6,0xb3,0x29,0xe3,0x2f,0x84,
+    0x53,0xd1,0x00,0xed,0x20,0xfc,0xb1,0x5b,0x6a,0xcb,0xbe,0x39,0x4a,0x4c,0x58,0xcf,
+    0xd0,0xef,0xaa,0xfb,0x43,0x4d,0x33,0x85,0x45,0xf9,0x02,0x7f,0x50,0x3c,0x9f,0xa8,
+    0x51,0xa3,0x40,0x8f,0x92,0x9d,0x38,0xf5,0xbc,0xb6,0xda,0x21,0x10,0xff,0xf3,0xd2,
+    0xcd,0x0c,0x13,0xec,0x5f,0x97,0x44,0x17,0xc4,0xa7,0x7e,0x3d,0x64,0x5d,0x19,0x73,
+    0x60,0x81,0x4f,0xdc,0x22,0x2a,0x90,0x88,0x46,0xee,0xb8,0x14,0xde,0x5e,0x0b,0xdb,
+    0xe0,0x32,0x3a,0x0a,0x49,0x06,0x24,0x5c,0xc2,0xd3,0xac,0x62,0x91,0x95,0xe4,0x79,
+    0xe7,0xc8,0x37,0x6d,0x8d,0xd5,0x4e,0xa9,0x6c,0x56,0xf4,0xea,0x65,0x7a,0xae,0x08,
+    0xba,0x78,0x25,0x2e,0x1c,0xa6,0xb4,0xc6,0xe8,0xdd,0x74,0x1f,0x4b,0xbd,0x8b,0x8a,
+    0x70,0x3e,0xb5,0x66,0x48,0x03,0xf6,0x0e,0x61,0x35,0x57,0xb9,0x86,0xc1,0x1d,0x9e,
+    0xe1,0xf8,0x98,0x11,0x69,0xd9,0x8e,0x94,0x9b,0x1e,0x87,0xe9,0xce,0x55,0x28,0xdf,
+    0x8c,0xa1,0x89,0x0d,0xbf,0xe6,0x42,0x68,0x41,0x99,0x2d,0x0f,0xb0,0x54,0xbb,0x16};
+
+inline uint8_t XTime(uint8_t x) {
+  return static_cast<uint8_t>((x << 1) ^ ((x & 0x80) ? 0x1b : 0x00));
+}
+
+// AES-256: Nk = 8, Nr = 14, so 15 round keys of 16 bytes.
+struct Aes256Key {
+  uint8_t rk[240];
+};
+
+inline void Aes256Expand(Aes256Key* k, const uint8_t key[32]) {
+  memcpy(k->rk, key, 32);
+  uint8_t rcon = 1;
+  for (int i = 8; i < 60; ++i) {
+    uint8_t t[4];
+    memcpy(t, k->rk + 4 * (i - 1), 4);
+    if (i % 8 == 0) {
+      uint8_t tmp = t[0];
+      t[0] = static_cast<uint8_t>(kSbox[t[1]] ^ rcon);
+      t[1] = kSbox[t[2]];
+      t[2] = kSbox[t[3]];
+      t[3] = kSbox[tmp];
+      rcon = XTime(rcon);
+    } else if (i % 8 == 4) {
+      for (int j = 0; j < 4; ++j) t[j] = kSbox[t[j]];
+    }
+    for (int j = 0; j < 4; ++j) {
+      k->rk[4 * i + j] = static_cast<uint8_t>(k->rk[4 * (i - 8) + j] ^ t[j]);
+    }
+  }
+}
+
+inline void Aes256EncryptBlock(const Aes256Key* k, const uint8_t in[16],
+                               uint8_t out[16]) {
+  uint8_t s[16];
+  for (int i = 0; i < 16; ++i) s[i] = static_cast<uint8_t>(in[i] ^ k->rk[i]);
+
+  for (int round = 1; round <= 14; ++round) {
+    for (int i = 0; i < 16; ++i) s[i] = kSbox[s[i]];
+
+    // ShiftRows, on a column-major state.
+    uint8_t t;
+    t = s[1]; s[1] = s[5]; s[5] = s[9]; s[9] = s[13]; s[13] = t;
+    t = s[2]; s[2] = s[10]; s[10] = t;
+    t = s[6]; s[6] = s[14]; s[14] = t;
+    t = s[15]; s[15] = s[11]; s[11] = s[7]; s[7] = s[3]; s[3] = t;
+
+    if (round != 14) {
+      for (int c = 0; c < 4; ++c) {
+        uint8_t* col = s + 4 * c;
+        uint8_t a0 = col[0], a1 = col[1], a2 = col[2], a3 = col[3];
+        uint8_t all = static_cast<uint8_t>(a0 ^ a1 ^ a2 ^ a3);
+        col[0] = static_cast<uint8_t>(a0 ^ all ^ XTime(a0 ^ a1));
+        col[1] = static_cast<uint8_t>(a1 ^ all ^ XTime(a1 ^ a2));
+        col[2] = static_cast<uint8_t>(a2 ^ all ^ XTime(a2 ^ a3));
+        col[3] = static_cast<uint8_t>(a3 ^ all ^ XTime(a3 ^ a0));
+      }
+    }
+    for (int i = 0; i < 16; ++i) {
+      s[i] = static_cast<uint8_t>(s[i] ^ k->rk[16 * round + i]);
+    }
+  }
+  memcpy(out, s, 16);
+}
+
+}  // namespace portable_crypto_detail
+
+// EVP shims. Only the ECB-single-block path PRF uses is supported.
+typedef struct {
+  portable_crypto_detail::Aes256Key key;
+  int initialised;
+} EVP_CIPHER_CTX;
+
+typedef struct {
+  int unused;
+} EVP_CIPHER;
+
+inline const EVP_CIPHER* EVP_aes_256_ecb() {
+  static const EVP_CIPHER kEcb = {0};
+  return &kEcb;
+}
+
+inline EVP_CIPHER_CTX* EVP_CIPHER_CTX_new() {
+  return new EVP_CIPHER_CTX{{}, 0};
+}
+
+inline void EVP_CIPHER_CTX_free(EVP_CIPHER_CTX* ctx) { delete ctx; }
+
+inline int EVP_EncryptInit_ex(EVP_CIPHER_CTX* ctx, const EVP_CIPHER*, void*,
+                              const uint8_t* key, const uint8_t*) {
+  if (ctx == nullptr || key == nullptr) return 0;
+  portable_crypto_detail::Aes256Expand(&ctx->key, key);
+  ctx->initialised = 1;
+  return 1;
+}
+
+// Encrypts whole 16-byte blocks. Matches EVP_EncryptUpdate's behaviour for
+// block-aligned ECB input, which is all PRF::Eval ever passes.
+inline int EVP_EncryptUpdate(EVP_CIPHER_CTX* ctx, uint8_t* out, int* out_len,
+                             const uint8_t* in, int in_len) {
+  if (ctx == nullptr || !ctx->initialised || in_len % 16 != 0) return 0;
+  for (int off = 0; off < in_len; off += 16) {
+    portable_crypto_detail::Aes256EncryptBlock(&ctx->key, in + off, out + off);
+  }
+  if (out_len != nullptr) *out_len = in_len;
+  return 1;
+}
+
+// ---------------------------------------------------------------------------
+// RAND_bytes. Backed by getentropy, which emscripten routes to
+// crypto.getRandomValues in the browser.
+// ---------------------------------------------------------------------------
+
+inline int RAND_bytes(uint8_t* out, size_t n) {
+  while (n > 0) {
+    size_t chunk = n > 256 ? 256 : n;  // getentropy caps at 256 bytes.
+    if (getentropy(out, chunk) != 0) return 0;
+    out += chunk;
+    n -= chunk;
+  }
+  return 1;
+}
+
+#endif  // PRIVACY_PROOFS_ZK_LIB_UTIL_PORTABLE_CRYPTO_H_
