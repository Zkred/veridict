# Copy to .env and fill in real values. The .env file is gitignored.
# Both issuer/server.py and backend/main.py auto-load this file at startup.

# ---- GitHub OAuth (issuer/server.py) ---------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Slug of the GitHub org whose members can mint credentials.
REQUIRED_ORG=

# Public-facing base URL of the issuer — must match the GitHub OAuth app's
# Authorization callback URL (callback path is /callback).
BASE_URL=http://localhost:8000

# Where the issuer posts proofs.
BACKEND_URL=http://localhost:8001

# Proving happens in the reviewer's browser (WebAssembly), so the issuer no
# longer runs a prover binary. It serves the compiled module instead; build it
# with prover/wasm/build.sh.
WASM_DIR=./prover/wasm/dist

# Cached circuit blob, shared by prover and verifier. Generating it instead costs
# ~15 s per invocation; loading it takes proving to ~0.5 s and verifying to ~0.8 s.
# Regenerate or re-check with: ./prover/build/circuit_tool --check <path> --spec 0
CIRCUIT_PATH=./prover/circuits/8d079211715200ff06c5109639245502bfe94aa869908d31176aae4016182121

# ---- Backend (backend/main.py) ---------------------------------------
ISSUER_URL=http://localhost:8000
# Verification order: the standalone module run in-process by wasmtime (no node,
# no subprocess, no compiled binary — this is the one that works on serverless),
# then the same module under node, then the native binary.
WASM_STANDALONE=./prover/wasm/dist/veridict_standalone.wasm
WASM_VERIFIER=./prover/wasm/verify.cjs
VERIFIER_BIN=./prover/build/verifier_cli
REQUIRED_APPROVALS=2

# PAT with `repo:status` scope — the "bot identity" used to push commit
# statuses. Reviewers don't need write access; only this token does.
GITHUB_BOT_TOKEN=
STATUS_CONTEXT=zk-review-gate

# ---- GitHub App (issuer + backend) -----------------------------------
# Used by the issuer to post commit statuses / comments as the bot, and to
# create branches + PRs for AI-synthesized code.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./.secrets/app-private-key.pem
GITHUB_APP_INSTALLATION_ID=

# ---- Formal spec gate (issuer/spec_gate.py) --------------------------
# Where the mypy/pytest/Z3 verdict comes from.
#
#   ci-required   only a successful GitHub Actions check run permits issuance.
#                 Use this in production: it keeps attacker-influenced PR code
#                 out of the process that holds the signing key.
#   ci-preferred  use the CI verdict when present, else run the checks in-process.
#                 Default, so repos without the workflow still work.
#   local         always run in-process (the old behaviour; leaves that path open).
#
# Adopt the gate in a reviewed repo by copying templates/veridict-spec-gate.yml
# to .github/workflows/ there, then switch this to ci-required.
SPEC_GATE_MODE=ci-preferred
# Check-run name to look for. Must match the workflow's job name.
SPEC_GATE_CHECK_NAME=veridict-spec-gate
# Only check runs created by this GitHub App slug are trusted, because anyone with
# checks:write could otherwise publish a passing gate for their own PR.
SPEC_GATE_TRUSTED_APP_SLUG=github-actions

# ---- AI synthesis (issuer/synthesize route) --------------------------
# Anthropic API key for Claude-based code synthesis.
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5).
# ANTHROPIC_MODEL=claude-sonnet-5

# ---- Dev bypass ------------------------------------------------------
# Set to 1 to enable /dev/credential (used by scripts/demo.sh).
DEV_MODE=0

# ======================================================================
# Deployment (Vercel or any serverless host)
# ======================================================================
# Locally, none of the below is needed: state goes to SQLite and keys are read
# from files. On a serverless host neither works — the filesystem is ephemeral
# and read-only — so state and secrets both move to the environment.

# Which service this deployment is. api/index.py serves one or the other.
# Deploy as TWO projects so no single function holds both the issuer's signing
# key and the GitHub App key.
#   VERIDICT_ROLE=issuer
#   VERIDICT_ROLE=backend
VERIDICT_ROLE=issuer

# Postgres connection string. Provision with:
#   vercel integration add neon
# which injects DATABASE_URL automatically. Unset locally to use SQLite.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Secrets as base64, since there is nowhere to put a file. Generate with:
#   base64 -i issuer_key.pem | tr -d '\n'
#   base64 -i .secrets/pseudonym-key.bin | tr -d '\n'
#   base64 -i .secrets/app-private-key.pem | tr -d '\n'
#
# These must be STABLE across deployments and instances. A rotated issuer key
# invalidates every credential already issued; a rotated pseudonym key makes one
# reviewer look like several. Both fail loudly rather than regenerating when the
# filesystem is read-only.
# ISSUER_KEY_B64=
# PSEUDONYM_KEY_B64=
# GITHUB_APP_PRIVATE_KEY_B64=
